# ==============================================================================
# CloudControl: Proxmox VPC & Single-IP Cloud Platform Configuration
# ==============================================================================

# Core Settings
PROJECT_NAME="CloudControl Proxmox VPC"
# Signs login tokens. Required when MOCK_PROXMOX=false; generate with: openssl rand -hex 32
# If left empty in mock mode, a random per-process key is used and logins reset on restart.
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Single Public IPv4 & Domain Routing
# Replace with your actual WAN IPv4 and your domain
PUBLIC_IP="203.0.113.10"
BASE_DOMAIN="cloud.yourdomain.com"
CADDY_ADMIN_API_URL="http://localhost:2019"
PORT_FORWARD_MIN=20000
PORT_FORWARD_MAX=29999

# Proxmox VE API Connection
# Set MOCK_PROXMOX=false when connecting to your live Proxmox host
MOCK_PROXMOX=true
PROXMOX_HOST="192.168.1.100"
PROXMOX_PORT=8006
PROXMOX_USER="root@pam"
PROXMOX_TOKEN_NAME="api_token"
PROXMOX_TOKEN_VALUE="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
PROXMOX_PASSWORD=""
PROXMOX_VERIFY_SSL=false
PROXMOX_DEFAULT_NODE="pve"
PROXMOX_STORAGE_POOL="local-lvm"
PROXMOX_SDN_ZONE="sdnzone"

# Proxmox Template IDs (created via proxmox-setup/create_templates.sh)
PROXMOX_ROUTER_TEMPLATE_ID=9000
PROXMOX_UBUNTU_TEMPLATE_ID=9001
PROXMOX_DEBIAN_TEMPLATE_ID=9002
PROXMOX_ALPINE_TEMPLATE_ID=9003

# Stripe Billing & Checkout
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
STRIPE_CURRENCY="usd"
# Lets any user switch plans without paying. Development and demos only.
BILLING_SIMULATOR_ENABLED=false

# Database & Frontend
DATABASE_URL="sqlite+aiosqlite:///./cloud_platform.db"
FRONTEND_URL="http://localhost:3000"
